{
	email {$ACME_EMAIL}
	acme_dns cloudflare {file./run/secrets/cloudflare_token}
}

*.home.{$DOMAIN} {
	@openbao host openbao.home.{$DOMAIN}
	handle @openbao {
		reverse_proxy openbao:8200
	}

	@pve host pve.home.{$DOMAIN}
	handle @pve {
		reverse_proxy https://192.168.1.10:8006 {
			transport http {
				tls_server_name pve.home.{$DOMAIN}
			}
		}
	}

	@pve-desktop host pve-desktop.home.{$DOMAIN}
	handle @pve-desktop {
		reverse_proxy https://192.168.1.11:8006 {
			transport http {
				tls_server_name pve-desktop.home.{$DOMAIN}
			}
		}
	}

	@s3 host s3.home.{$DOMAIN}
	handle @s3 {
		reverse_proxy garage:3900
	}

	@auth host auth.home.{$DOMAIN}
	handle @auth {
		reverse_proxy pocket-id:1411
	}

	handle {
		abort
	}
}
